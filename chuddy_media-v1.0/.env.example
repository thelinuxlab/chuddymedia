# Chuddy Media environment settings
# Copy this file to ".env" (same folder as manage.py) and fill in your values.
# Never commit ".env" or share it: it holds secrets.

# --- Django core ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
# 1 = development, 0 = live website
DEBUG=1
# Comma-separated domains, e.g. chuddymedia.com,www.chuddymedia.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email: contact form messages are delivered to chuddymedia@gmail.com ---
# Google Account > Security > 2-Step Verification > App passwords.
# Paste the 16-character code here (not your normal Gmail password).
GMAIL_APP_PASSWORD=

# --- Social media links (shown in the popup; leave blank to hide) ---
URL_FACEBOOK=
URL_INSTAGRAM=https://instagram.com/oscarchuddy
URL_TIKTOK=
URL_X=
URL_YOUTUBE=
